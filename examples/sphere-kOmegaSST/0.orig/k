FoamFile
{
    version     2.0;
    format      ascii;
    class       volScalarField;
    object      k;
}

dimensions      [0 2 -2 0 0 0 0];
internalField   uniform 0.06;

boundaryField
{
    inlet    { type fixedValue; value uniform 0.06; }
    outlet   { type inletOutlet; inletValue uniform 0.06; value uniform 0.06; }
    farfield { type zeroGradient; }
    sphere   { type kqRWallFunction; value uniform 0.06; }
}
